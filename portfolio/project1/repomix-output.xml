#!/usr/bin/env python3
"""Generate the instrument table for both sides from instruments.csv.

DESIGN.md §13: symbols must not appear in the hot path, and the symbol-to-id
mapping needs one source of truth rather than two that agree today. The CSV is

Generated files are committed so that building needs no Python. CI runs
--check, which fails if a generated file has drifted from the CSV.

    ./tools/gen_instruments.py              # write
    ./tools/gen_instruments.py --check      # verify, exit 1 on drift
"""

import argparse
import csv
import pathlib
import sys

ROOT = pathlib.Path(__file__).resolve().parent.parent
CSV = ROOT / "instruments.csv"
HPP = ROOT / "instruments_generated.hpp"
RS = ROOT / "router" / "src" / "instruments_generated.rs"

BANNER = "// GENERATED by tools/gen_instruments.py from instruments.csv. Do not edit."

def load():
    rows = []
    with CSV.open(newline="") as f:
        for raw in csv.reader(r for r in f if not r.lstrip().startswith("#") and r.strip()):
            iid, sym, exch, pdec, tick, qdec = (c.strip() for c in raw)
            rows.append(
                dict(id=int(iid), symbol=sym, exchange=exch,
                price_decimals=int(pdec), tick_units=int(tick),
                qty_decimals=int(qdec))
            )
    if not rows: sys.exit("instruments.csv has no rows")
    # id is an array index, so the ids must be exactly 1..n with no holes --
    # a gap would mean the engine's per-instrument arrays have dead entries
    # that index arithmetic would still happily reach.
    if [r["id"] for r in rows] != list(range(1, len(rows) + 1)):
        sys.exit("instrument ids must be 1..n contiguous, in order")
    if len(set(r["symbol"] for r in rows)) != len(rows):
        sys.exit("duplicate symbol")
    for r in rows:
        if r["tick_units"] < 1:
            sys.exit(f"{r['symbol']}: tick_units must be >= 1")
    return rows

def cpp(rows):
    n = len(rows)
    out = [
        BANNER, "", "#pragma once", "", "#include <cstdint>", "",
        "namespace mkt", "{", "",
        f"inline constexpr uint32_t kInstrumentCount = {n};", "",
        "struct Instrument",
        "{",
        "    const char *symbol;",
        "    const char *exchange;",
        "    uint8_t price_decimals;",
        "    int64_t tick_units;",
        "    uint8_t qty_decimals;",
        "};", "",
        "// Index 0 is the reserved invalid id and is present so that",
        "// instrument_id indexes this array directly, with no offset.",
        f"inline constexpr Instrument kInstruments[{n} + 1] = {{",
        '    {"", "", 0, 0, 0},'
    ]
    for r in rows:
        out.append(
            f'   {{"{r["symbol"]}", "{r["exchange"]}", '
            f'{r["price_decimals"]}, {r["tick_units"]}, {r["qty_decimals"]}}},'
        )
    out += ["", "}  // namespace mkt", ""]
    return "\n".join(out)

def rust(rows):
    n = len(rows)
    out = [
        BANNER, "", f"pub const INSTRUMENT_COUNT: u32 = {n};", "",
        "#[derive(Clone, Copy, Debug)]",
        "pub struct Instrument {",
        "    pub symbol: &'static str,",
        "    pub exchange: &'static str,",
        "    pub price_decimals: u8,",
        "    pub tick_units: i64,",
        "    pub qty_decimals: u8,",
        "}", "",
        "/// Index 0 is the reserved invalid id, so `instrument_id` indexes",
        "/// this table directly with no offset.",
        f"pub const INSTRUMENTS: [Instrument; {n} + 1] = [",
        '    Instrument { symbol: "", exchange: "", price_decimals: 0, '
        "tick_units: 0, qty_decimals: 0 },"
    ]
    for r in rows:
        out.append(
            f'   Instrument {{ symbol: "{r["symbol"]}", exchange: "{r["exchange"]}", '
            f'price_decimals: {r["price_decimals"]}, tick_units: {r["tick_units"]}, '
            f'qty_decimals: {r["qty_decimals"]} }},'
        )
    out += ["];", ""]
    for r in rows:
        out.append(f'pub const ID_{r["symbol"].upper()}: u32 = {r["id"]};')
    out.append("")
    return "\n".join(out)

def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--check", action="store_true")
    args = ap.parse_args()
    
    rows = load()
    want = {HPP: cpp(rows), RS: rust(rows)}
    bad = False
    for path, text in want.items():
        if args.check:
            have = path.read_text() if path.exists() else None
            if have != text:
                print(f"drift: {path.relative_to(ROOT)}", file=sys.stderr)
                bad = True
        else:
            path.parent.mkdir(parents=True, exist_ok=True)
            path.write_text(text)
            print(f"wrote {path.relative_to(ROOT)}")
    if bad: sys.exit("regenerate with tools/gen_instruments.py")
    
if __name__ == "__main__":
    main()
</file>

