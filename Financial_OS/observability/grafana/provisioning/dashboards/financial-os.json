{
  "uid": "financial-os",
  "title": "Financial OS - distributed workers",
  "tags": ["financial-os"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Queue depth (celery)",
      "description": "Backlog lives on the same timescale as the scrape interval; a zero here does not prove the queue never filled.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 6, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 100 },
              { "color": "red", "value": 500 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "redis_key_size{key=\"celery\"}",
          "legendFormat": "celery"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Task throughput",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 5, "w": 18, "x": 6, "y": 0 },
      "fieldConfig": {
        "defaults": {
          "unit": "ops",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 10 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(celery_tasks_total[1m])) by (task_name, status)",
          "legendFormat": "{{task_name}} / {{status}}"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Task duration quantiles (run_backtest_job)",
      "description": "Buckets were retuned after the first measurement collapsed 115/118 samples into one bucket.",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": { "drawStyle": "line", "lineWidth": 2, "fillOpacity": 0 }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "histogram_quantile(0.50, sum(rate(celery_task_duration_seconds_bucket{task_name=\"run_backtest_job\"}[1m])) by (le))",
          "legendFormat": "p50"
        },
        {
          "refId": "B",
          "expr": "histogram_quantile(0.95, sum(rate(celery_task_duration_seconds_bucket{task_name=\"run_backtest_job\"}[1m])) by (le))",
          "legendFormat": "p95"
        },
        {
          "refId": "C",
          "expr": "sum(rate(celery_task_duration_seconds_sum{task_name=\"run_backtest_job\"}[1m])) / sum(rate(celery_task_duration_seconds_count{task_name=\"run_backtest_job\"}[1m]))",
          "legendFormat": "avg"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Work distribution across replicas",
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 5 },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "stacking": { "mode": "normal" }
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(celery_tasks_total) by (instance)",
          "legendFormat": "{{instance}}"
        }
      ]
    }
  ]
}
